# Production Dockerfile for rembish.org frontend
# Multi-stage build: node build → nginx:alpine
# Build context should be repo root: docker build -f app/frontend/Dockerfile.prod .

# Stage 1: Build
FROM node:22-slim AS builder

WORKDIR /app

COPY app/frontend/package.json app/frontend/package-lock.json ./
RUN npm ci

COPY app/frontend/ .
COPY CHANGELOG.md public/CHANGELOG.md
RUN npm run build

# Stage 2: Runtime
FROM nginx:alpine

# Distrust emSign ECC Root CA - G3: it cross-signs eMudhra intermediates whose
# private keys leaked in Oct 2026, and Alpine's ca-certificates still ships it.
# nginx only ever talks to the Cloud Run backend, so nothing legitimate needs it.
# The grep fails the build once Alpine drops the root — then delete this step.
RUN sed -i 's|^mozilla/emSign_ECC_Root_CA_-_G3.crt|!&|' /etc/ca-certificates.conf \
    && grep -qx '!mozilla/emSign_ECC_Root_CA_-_G3.crt' /etc/ca-certificates.conf \
    && update-ca-certificates

# Copy built assets
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy nginx config template
COPY app/frontend/nginx.conf /etc/nginx/templates/default.conf.template

# Copy entrypoint script
COPY app/frontend/docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

# Cloud Run expects port 8080
EXPOSE 8080

ENTRYPOINT ["/docker-entrypoint.sh"]
CMD ["nginx", "-g", "daemon off;"]
